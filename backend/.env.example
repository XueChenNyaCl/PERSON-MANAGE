# 数据库配置
DATABASE_URL=postgres://username:password@localhost:5432/school_management

# JWT配置
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# 日志配置
RUST_LOG=info

# WebSocket配置
WS_PATH=/ws

# 插件目录
PLUGIN_DIR=plugins

# === Redis 配置 ===
# Redis 连接地址 (WSL2 通过端口转发)
REDIS_URL=redis://127.0.0.1:6379

# Redis 连接池大小
REDIS_POOL_SIZE=10

# Redis 连接超时（秒）
REDIS_TIMEOUT=5

# === 缓存配置 ===
# 默认缓存TTL（秒）
CACHE_DEFAULT_TTL=300

# 人员数据缓存TTL（秒）
CACHE_PERSON_TTL=600

# 班级数据缓存TTL（秒）
CACHE_CLASS_TTL=300

# 成绩数据缓存TTL（秒）
CACHE_SCORE_TTL=180

# 列表数据缓存TTL（秒）
CACHE_LIST_TTL=60

# === 写入缓冲配置 ===
# 缓冲刷新间隔（秒）
BUFFER_FLUSH_INTERVAL=300

# 缓冲队列最大长度
BUFFER_MAX_SIZE=10000

# 批量写入批次大小
BUFFER_BATCH_SIZE=100

# === 限流配置 ===
# Redis故障时每秒最大请求数
RATE_LIMIT_QPS=50

# === 监控配置 ===
# 监控检查间隔（秒）
MONITOR_INTERVAL=600

# 内存告警阈值（百分比）
MEMORY_ALERT_THRESHOLD=80
